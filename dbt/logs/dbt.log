select
    u.id                                          as series_id,
    u.item_id,
    u.dept_id,
    u.cat_id,
    u.store_id,
    u.state_id,
    c.calendar_date                               as sales_date,
    c.day_num,
    c.wm_yr_wk,
    try_cast(u.units_sold_raw as int)             as units_sold,
    p.sell_price,
    p.sell_price is not null                      as is_price_listed,
    c.event_name_1,
    c.event_type_1,
    c.event_name_2,
    c.event_type_2,
    case u.state_id
        when 'CA' then c.is_snap_ca
        when 'TX' then c.is_snap_tx
        when 'WI' then c.is_snap_wi
    end                                           as is_snap_day
from unpivoted as u
inner join `supply_chain_dev`.`silver`.`m5_calendar` as c
    on u.d = c.d
left join `supply_chain_dev`.`silver`.`m5_sell_prices` as p
    on  p.store_id  = u.store_id
    and p.item_id   = u.item_id
    and p.wm_yr_wk  = c.wm_yr_wk
where c.day_num <= 1941
  
